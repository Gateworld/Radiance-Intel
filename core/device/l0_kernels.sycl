/* SPDX-License-Identifier: Apache-2.0
 * Copyright 2026 Deadcode and the radiance contributors
 * Part of the Intel port of radiance (Level Zero backend + SYCL kernel library, milestone 1).
 *
 * l0_kernels.sycl -- the core's own device code on the Level Zero backend: the step advance
 * (sched/advance.hip) and the weight-table patch (runtime/wtab.hip), under the launcher names the
 * HIP build uses, so advance.cpp and wtab.cpp call them unchanged.
 *
 * Built as the shared library rad_l0k (cmake/RadL0.cmake), not into rad_core: every tool links the
 * core statically, and a SYCL device image only survives a link made with -fsycl, so the device code
 * lives in one library that is device-linked once. The extension keeps it out of the core's *.cpp
 * glob. The stream is the backend's sycl::queue (core/device/l0.cpp). No chained forms: chaining is
 * AQL-only (rad_dev_chain_enabled is 0 here).
 */
#include <sycl/sycl.hpp>

#include "sched/advance_impl.h"
#include "runtime/wtab.h"
#include "runtime/xprefetch.h"

#include <cmath>
#include <cstring>
#include "rad_l0_rec.h"

/* The backend's hook that submits a held-back tape play (l0.cpp, "recorded passes"): these
 * launches reach the queue without passing through the backend, so they flush it first. */
static void (*g_flush)(void) = nullptr;
extern "C" __attribute__((visibility("default"))) void rad_l0k_set_flush(void (*f)(void)) { g_flush = f; }
static inline void flush_pending() { if (g_flush) g_flush(); }

/* The native recorder (abi/rad_l0_rec.h, owner note 28): the backend's hooks, exported to the kernel
 * libraries. Without a backend (or on the SYCL-graph tapes) every query says "not recording". */
static const RadL0RecHooks* g_rec = nullptr;
extern "C" __attribute__((visibility("default"))) void rad_l0k_set_rec(const RadL0RecHooks* h) { g_rec = h; }
extern "C" __attribute__((visibility("default"))) int rad_l0k_rec_device(const void* queue) {
    return g_rec && g_rec->device ? g_rec->device(queue) : -1;
}
extern "C" __attribute__((visibility("default")))
int rad_l0k_rec_launch(const void* queue, const RadL0RecKernel* kernel, const uint32_t grid[3], const uint32_t block[3],
                       const void* arg0, size_t arg0_size, size_t lds) {
    return g_rec && g_rec->launch ? g_rec->launch(queue, kernel, grid, block, arg0, arg0_size, lds) : -1;
}
extern "C" __attribute__((visibility("default")))
int rad_l0k_rec_copy2d(const void* queue, void* dst, size_t dpitch, const void* src, size_t spitch,
                       size_t width, size_t height) {
    return g_rec && g_rec->copy2d ? g_rec->copy2d(queue, dst, dpitch, src, spitch, width, height) : -1;
}
/* A 1-D launch of the lambda `kfn` (one by-value capture, `args`) on `stream`: natively while the
 * calling thread records that stream, else through the queue. */
template <class A, class F>
static int launch_1d(void* stream, const A& args, const F& kfn, size_t global, size_t wg) {
    sycl::queue& q = *static_cast<sycl::queue*>(stream);
    const int rd = rad_l0k_rec_device(stream);
    if (rd >= 0) {
        const uint32_t grid[3] = {(uint32_t)(global / wg), 1, 1}, block[3] = {(uint32_t)wg, 1, 1};
        if (const RadL0RecKernel* k = rad_l0_rec::kernel_of<F>(q, rd)) {
            if (rad_l0k_rec_launch(stream, k, grid, block, &args, sizeof args, 0) == 0) return 0;
        } else {
            /* no kernel object: told to the backend, which orders the plain launch below (RADIANCE_L0_GLUE) */
            (void)rad_l0k_rec_launch(stream, nullptr, grid, block, nullptr, 0, 0);
        }
    }
    try {
        q.parallel_for(sycl::nd_range<1>(global, wg), kfn);
    } catch (const sycl::exception&) {
        return -1;
    }
    return 0;
}

/* The backend's devices for kernel libraries that allocate at init (milestone 2: libxe's all-reduce
 * rows allocate their scratch and flags per rank before load, when they have no stream yet). The
 * backend registers a provider at startup; a library asks for rank r's device and the context that
 * every card shares (l0.cpp discover). Null before the backend is up, or past the device count. */
static const sycl::device*  (*g_dev_of)(int) = nullptr;
static const sycl::context* (*g_ctx_of)(int) = nullptr;
static int g_n_dev = 0;
extern "C" __attribute__((visibility("default")))
void rad_l0k_set_devices(int n, const sycl::device* (*dev_of)(int), const sycl::context* (*ctx_of)(int)) {
    g_n_dev = n; g_dev_of = dev_of; g_ctx_of = ctx_of;
}
extern "C" __attribute__((visibility("default")))
int rad_l0k_device(int index, const sycl::device** dev, const sycl::context** ctx) {
    if (!g_dev_of || !g_ctx_of || index < 0 || index >= g_n_dev) return -1;
    if (dev) *dev = g_dev_of(index);
    if (ctx) *ctx = g_ctx_of(index);
    return 0;
}

extern "C" __attribute__((visibility("default")))
int rad_step_advance_launch(const rad::AdvanceArgs* args, void* stream) {
    if (!args || args->n_seq <= 0) return 0;
    flush_pending();
    const rad::AdvanceArgs a = *args;
    const size_t threads = 64, blocks = (size_t)((a.n_seq + 63) / 64);
    auto kfn = [=](sycl::nd_item<1> it) {
        const int i = (int)it.get_global_id(0);
        if (i < a.n_seq) rad::adv_row(a, i);
    };
    return launch_1d(stream, a, kfn, blocks * threads, threads);
}

/* A byte fill as a kernel, for host-memory destinations: queue::memset into pinned host memory left
 * the tail of the range unwritten on card1 (device_test memset_async and the pinned-range test, runs
 * b1/b2), with the queue waited for. 16 bytes a work-item, the head and tail bytewise. */
extern "C" __attribute__((visibility("default")))
int rad_l0k_fill(void* stream, void* dst, int value, int64_t bytes) {
    if (!dst || bytes <= 0) return 0;
    struct Fill { unsigned char* p; int64_t head, body, tail; unsigned char v; };
    Fill f;
    f.p = (unsigned char*)dst;
    f.v = (unsigned char)value;
    f.head = (int64_t)((16 - ((uintptr_t)f.p & 15)) & 15) < bytes ? (int64_t)((16 - ((uintptr_t)f.p & 15)) & 15) : bytes;
    f.body = (bytes - f.head) / 16;
    f.tail = bytes - f.head - f.body * 16;
    const size_t items = (size_t)(f.body + 16);   /* + 16 lanes for head and tail bytes */
    const size_t wg = 256, global = (items + wg - 1) / wg * wg;
    auto kfn = [=](sycl::nd_item<1> it) {
        const int64_t i = (int64_t)it.get_global_id(0);
        if (i < f.body) {
            sycl::vec<unsigned char, 16> x(f.v);
            *(sycl::vec<unsigned char, 16>*)(f.p + f.head + 16 * i) = x;
        } else if (i < f.body + 16) {
            const int64_t k = i - f.body;   /* lane k writes head byte k and tail byte k */
            if (k < f.head) f.p[k] = f.v;
            if (k < f.tail) f.p[f.head + 16 * f.body + k] = f.v;
        }
    };
    return launch_1d(stream, f, kfn, global, wg);
}

/* ---- the expert prefetch (runtime/xprefetch.h; owner note 139 stage 1): xprefetch.hip's kernels for this
 * backend, plus the gather that stands in for the DMA queue. Logits, plan and gather run on the prefetch's
 * own queue, which is never recorded; the step runs on the compute stream and records natively. */
namespace {
using u64 = unsigned long long;
template <class T> using dev_atomic =
    sycl::atomic_ref<T, sycl::memory_order::relaxed, sycl::memory_scope::device, sycl::access::address_space::global_space>;
inline float xp_bf(uint32_t x) { return sycl::bit_cast<float>(x << 16); }
inline u64 xp_ld(void** p) { return dev_atomic<u64>(*(u64*)p).load(); }
}  // namespace

/* logits[r, e] = h[r, :] . w[e, :], bf16 in, fp32 sums: a 16-lane sub-group an expert, 16-byte loads. Through
 * launch_1d, so it records with the stream (owner note 139 stage 1 v2 runs it on the compute stream). */
extern "C" __attribute__((visibility("default")))
int rad_xp_logits_launch(const uint16_t* h, const uint16_t* w, float* lg, uint32_t rows, uint32_t n_embd, uint32_t ne,
                         void* stream) {
    if (rows == 0 || rows > (uint32_t)rad::kXpMaxRows || n_embd % 256u) return -1;
    flush_pending();
    /* No padding bytes: the recorder compares a recording's by-value argument byte for byte (run 113's M178 failed
     * on 4 uninitialised tail bytes), so `pad` fills the struct and is zero. */
    struct LogitsArgs { const uint16_t* h; const uint16_t* w; float* lg; uint32_t rows, n_embd, ne, pad; };
    const LogitsArgs a{ h, w, lg, rows, n_embd, ne, 0u };
    auto kfn = [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
        const sycl::sub_group sg = it.get_sub_group();
        const uint32_t lane = sg.get_local_linear_id();
        const uint32_t e = (uint32_t)it.get_group(0) * 16u + sg.get_group_linear_id();   /* 16 experts a group */
        if (e >= a.ne) return;
        const uint32_t nv = a.n_embd / 8u;
        const sycl::uint4* wr = (const sycl::uint4*)(a.w + (size_t)e * a.n_embd);
        float acc[rad::kXpMaxRows];
#pragma unroll
        for (int r = 0; r < rad::kXpMaxRows; ++r) acc[r] = 0.f;
        for (uint32_t c = lane; c < nv; c += 16u) {
            const sycl::uint4 wv = wr[c];
            float wf[8];
#pragma unroll
            for (int t = 0; t < 4; ++t) { wf[2 * t] = xp_bf(wv[t] & 0xffffu); wf[2 * t + 1] = xp_bf(wv[t] >> 16); }
#pragma unroll
            for (int r = 0; r < rad::kXpMaxRows; ++r) {
                if ((uint32_t)r >= a.rows) break;
                const sycl::uint4 hv = ((const sycl::uint4*)(a.h + (size_t)r * a.n_embd))[c];
                float d = 0.f;
#pragma unroll
                for (int t = 0; t < 4; ++t) d += wf[2 * t] * xp_bf(hv[t] & 0xffffu) + wf[2 * t + 1] * xp_bf(hv[t] >> 16);
                acc[r] += d;
            }
        }
#pragma unroll
        for (int r = 0; r < rad::kXpMaxRows; ++r) {
            if ((uint32_t)r >= a.rows) break;
            const float v = sycl::reduce_over_group(sg, acc[r], sycl::plus<float>());
            if (lane == 0) a.lg[(size_t)r * a.ne + e] = v;
        }
    };
    return launch_1d(stream, a, kfn, (size_t)((ne + 15u) / 16u) * 256, 256);
}

/* xprefetch.hip's xp_plan, one work-group of 256 at sub-group 32 (16 logits a lane cover 512 experts): count
 * whether the step routed the group's last records, each row's top-k with softmax probabilities, the distinct
 * experts whose entries all sit in one pinned pool slot, scored by their best probability (x1.5 if the last pass
 * routed them here), the kXpSlots best written as jobs and records. Through launch_1d (one argument struct, static
 * local memory), so it records with the stream. With `tick` (owner note 139 stage 1 v2) the request's number is
 * the group's device ticket, bumped here, so a recorded plan numbers every play anew; the jobs' tags and the
 * mailbox number are then system-scope stores after a release, for the host thread that polls the pinned box.
 * Without it (gather mode) the box is device memory, read by the gather that follows on the same queue. */
namespace {
struct XpPlanArgs {
    const float* lg; uint32_t rows, ne, k; void** const* map; const int32_t* place; const int32_t* cnt;
    rad::XpPools pools; uint64_t ring, rs; rad::XpRec* rec; int32_t* nrec; rad::XpBox* box; uint32_t seq;
    uint32_t* tick; rad::XpStats* stats;
};
/* Field by field into an already zeroed struct, so XpPools' tail padding stays zero (see the launchers). */
inline void xp_set_pools(rad::XpPools& d, const rad::XpPools& s) {
    for (int i = 0; i < rad::kXpMaxPools; ++i) { d.lo[i] = s.lo[i]; d.hi[i] = s.hi[i]; d.stride[i] = s.stride[i]; }
    d.n = s.n;
}
template <class T> using sys_atomic =
    sycl::atomic_ref<T, sycl::memory_order::relaxed, sycl::memory_scope::system, sycl::access::address_space::global_space>;
int xp_plan_impl(const XpPlanArgs& a, void* stream) {
    if (a.k == 0 || a.k > (uint32_t)rad::kXpMaxK || a.ne > (uint32_t)rad::kXpMaxNe || a.rows == 0 ||
        a.rows > (uint32_t)rad::kXpMaxRows)
        return -1;
    flush_pending();
    auto kfn = [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
                constexpr int NC = rad::kXpMaxRows * rad::kXpMaxK;
                constexpr float kPrevBoost = 0.5f;
                const float* lg = a.lg; const uint32_t rows = a.rows, ne = a.ne, k = a.k;
                void** const* map = a.map; const int32_t* place = a.place; const int32_t* cnt = a.cnt;
                const rad::XpPools& pools = a.pools; const uint64_t ring = a.ring, rs = a.rs;
                rad::XpRec* rec = a.rec; int32_t* nrec = a.nrec; rad::XpBox* box = a.box; rad::XpStats* stats = a.stats;
                const sycl::group<1> grp = it.get_group();
                int* s_e = *sycl::ext::oneapi::group_local_memory_for_overwrite<int[NC]>(grp);
                int* s_pool = *sycl::ext::oneapi::group_local_memory_for_overwrite<int[NC]>(grp);
                int* s_sel = *sycl::ext::oneapi::group_local_memory_for_overwrite<int[rad::kXpSlots]>(grp);
                int* s_n = *sycl::ext::oneapi::group_local_memory_for_overwrite<int[2]>(grp);   /* [0] n, [1] seq */
                float* s_pr = *sycl::ext::oneapi::group_local_memory_for_overwrite<float[NC]>(grp);
                float* s_sc = *sycl::ext::oneapi::group_local_memory_for_overwrite<float[NC]>(grp);
                u64* s_p = *sycl::ext::oneapi::group_local_memory_for_overwrite<u64[NC]>(grp);
                const sycl::sub_group sg = it.get_sub_group();
                const uint32_t tid = (uint32_t)it.get_local_id(0), lane = sg.get_local_linear_id();
                const uint32_t wave = sg.get_group_linear_id(), nw = sg.get_group_linear_range();
                if (tid == 0) {
                    s_n[1] = (int)(a.tick ? ++*a.tick : a.seq);
                    const int nr = *nrec;
                    for (int t = 0; t < nr; ++t) {
                        const rad::XpRec& rc = rec[t];
                        dev_atomic<unsigned>(stats->copied).fetch_add(1u);
                        if (rc.cnt && rc.place >= 0 && rc.cnt[rc.place] > 0) dev_atomic<unsigned>(stats->routed).fetch_add(1u);
                    }
                }
                /* Rank-major order: o = j * rows + r, every row's first choice before any second one. */
                for (uint32_t r = wave; r < rows; r += nw) {
                    float v[16];
                    float m = -INFINITY;
#pragma unroll
                    for (uint32_t i = 0; i < 16; ++i) {
                        const uint32_t e = lane + i * 32u;
                        v[i] = e < ne ? lg[(size_t)r * ne + e] : -INFINITY;
                        m = sycl::fmax(m, v[i]);
                    }
                    m = sycl::reduce_over_group(sg, m, sycl::maximum<float>());
                    float sum = 0.f;
#pragma unroll
                    for (uint32_t i = 0; i < 16; ++i) sum += v[i] > -INFINITY ? sycl::exp(v[i] - m) : 0.f;
                    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
                    for (uint32_t j = 0; j < k; ++j) {
                        float bv = -INFINITY;
                        int bi = -1;
#pragma unroll
                        for (int i = 0; i < 16; ++i)
                            if (v[i] > bv) { bv = v[i]; bi = i; }
                        const int be = bi >= 0 ? (int)(lane + (uint32_t)bi * 32u) : 0x7fffffff;
                        float rv = bv;
                        int re = be;
                        for (uint32_t o = 16; o > 0; o >>= 1) {
                            const float ov = sycl::permute_group_by_xor(sg, rv, o);
                            const int oe = sycl::permute_group_by_xor(sg, re, o);
                            if (ov > rv || (ov == rv && oe < re)) { rv = ov; re = oe; }
                        }
                        if (lane == 0) {
                            s_e[j * rows + r] = re;
                            s_pr[j * rows + r] = sycl::exp(rv - m) / sum;
                        }
#pragma unroll
                        for (int i = 0; i < 16; ++i)
                            if (i == bi && re == be) v[i] = -INFINITY;
                    }
                }
                sycl::group_barrier(it.get_group());
                const uint32_t nc = rows * k;
                for (uint32_t o = tid; o < nc; o += 256u) {
                    const int e = s_e[o];
                    s_pool[o] = -1;
                    s_p[o] = 0;
                    if (e >= 0 && (uint32_t)e < ne) {
                        void** ent = map[(size_t)e * rad::kXpParts];
                        if (ent) {
                            const u64 p = xp_ld(ent);
                            s_p[o] = p;
                            int pi = -1;
                            for (int i = 0; i < pools.n; ++i)
                                if (p >= pools.lo[i] && p < pools.hi[i]) { pi = i; break; }
                            /* All entries of the unit in one pool slot (the mover patches one at a time). */
                            if (pi >= 0) {
                                const u64 lo = pools.lo[pi], st = pools.stride[pi];
                                const u64 base = lo + ((p - lo) / st) * st;
                                for (int qq = 1; qq < rad::kXpParts && pi >= 0; ++qq) {
                                    void** eq = map[(size_t)e * rad::kXpParts + qq];
                                    if (!eq) continue;
                                    const u64 vv = xp_ld(eq);
                                    if (vv < base || vv >= base + st) pi = -1;
                                }
                            }
                            s_pool[o] = pi;
                        }
                    }
                }
                sycl::group_barrier(it.get_group());
                for (uint32_t o = tid; o < nc; o += 256u) {
                    const int e = s_e[o];
                    float best = s_pr[o];
                    bool first = true;
                    for (uint32_t u = 0; u < nc; ++u)
                        if (s_e[u] == e) {
                            if (u < o) first = false;
                            best = sycl::fmax(best, s_pr[u]);
                        }
                    /* The counts row holds the previous pass until this layer's router runs. */
                    if (first && cnt && place && e >= 0 && (uint32_t)e < ne) {
                        const int pl = place[e];
                        if (pl >= 0 && cnt[pl] > 0) best *= 1.f + kPrevBoost;
                    }
                    s_sc[o] = (first && s_pool[o] >= 0) ? best : -1.f;
                }
                if (tid == 0) s_n[0] = 0;
                sycl::group_barrier(it.get_group());
                for (uint32_t o = tid; o < nc; o += 256u) {
                    const float sc = s_sc[o];
                    if (sc < 0.f) continue;
                    uint32_t rank = 0;
                    for (uint32_t u = 0; u < nc; ++u) {
                        const float su = s_sc[u];
                        if (su > sc || (su == sc && u < o)) ++rank;
                    }
                    if (rank < (uint32_t)rad::kXpSlots) {
                        s_sel[rank] = (int)o;
                        sycl::atomic_ref<int, sycl::memory_order::relaxed, sycl::memory_scope::work_group,
                                         sycl::access::address_space::local_space>(s_n[0]).fetch_add(1);
                    }
                }
                sycl::group_barrier(it.get_group());
                const int n = s_n[0];
                for (int t = (int)tid; t < n * rad::kXpParts; t += 256) {
                    const int j = t / rad::kXpParts, qq = t % rad::kXpParts, o = s_sel[j], e = s_e[o], pi = s_pool[o];
                    const u64 lo = pools.lo[pi], st = pools.stride[pi];
                    const u64 base = lo + ((s_p[o] - lo) / st) * st;
                    const u64 dst = ring + (u64)j * rs;
                    if (qq == 0) {
                        sys_atomic<u64>(*(u64*)&box->jobs[j].src).store(base);
                        sys_atomic<u64>(*(u64*)&box->jobs[j].dst).store(dst);
                        sys_atomic<u64>(*(u64*)&box->jobs[j].bytes).store(st);
                        rec[j].cnt = cnt;
                        rec[j].place = place ? place[e] : -1;
                    }
                    void** ent = map[(size_t)e * rad::kXpParts + qq];
                    rec[j].ent[qq] = ent;
                    if (ent) {
                        const u64 old = xp_ld(ent);
                        rec[j].oldv[qq] = (void*)old;
                        rec[j].newv[qq] = (void*)(dst + (old - base));
                    }
                    /* Tag after the job's stores, so a visible tag implies a complete job. */
                    if (qq == 0) {
                        sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::system);
                        sys_atomic<u64>(*(u64*)&box->jobs[j].tag).store((u64)(uint32_t)s_n[1]);
                    }
                }
                sycl::group_barrier(it.get_group());
                if (tid == 0) {
                    *nrec = n;
                    sys_atomic<int32_t>(box->n).store(n);
                    dev_atomic<unsigned>(stats->planned).fetch_add((unsigned)n);
                    sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::system);
                    sys_atomic<uint32_t>(*(uint32_t*)&box->seq).store((uint32_t)s_n[1]);
                }
    };
    return launch_1d(stream, a, kfn, 256, 256);
}
}  // namespace

extern "C" __attribute__((visibility("default")))
int rad_xp_plan_launch(const float* lg, uint32_t rows, uint32_t ne, uint32_t k, void** const* map, const int32_t* place,
                       const int32_t* cnt, rad::XpPools pools, uint64_t ring, uint64_t rs, rad::XpRec* rec,
                       int32_t* nrec, rad::XpBox* box, uint32_t seq, rad::XpStats* stats, void* stream) {
    XpPlanArgs a;
    std::memset(&a, 0, sizeof a);   /* the padding too: recordings compare the argument byte for byte */
    a.lg = lg; a.rows = rows; a.ne = ne; a.k = k; a.map = map; a.place = place; a.cnt = cnt;
    xp_set_pools(a.pools, pools);
    a.ring = ring; a.rs = rs; a.rec = rec; a.nrec = nrec; a.box = box; a.seq = seq; a.tick = nullptr; a.stats = stats;
    return xp_plan_impl(a, stream);
}
/* v2: the request number from the group's device ticket `tick` (see xp_plan_impl). */
extern "C" __attribute__((visibility("default")))
int rad_xp_plan2_launch(const float* lg, uint32_t rows, uint32_t ne, uint32_t k, void** const* map, const int32_t* place,
                        const int32_t* cnt, rad::XpPools pools, uint64_t ring, uint64_t rs, rad::XpRec* rec,
                        int32_t* nrec, rad::XpBox* box, uint32_t* tick, rad::XpStats* stats, void* stream) {
    if (!tick) return -1;
    XpPlanArgs a;
    std::memset(&a, 0, sizeof a);   /* the padding too: recordings compare the argument byte for byte */
    a.lg = lg; a.rows = rows; a.ne = ne; a.k = k; a.map = map; a.place = place; a.cnt = cnt;
    xp_set_pools(a.pools, pools);
    a.ring = ring; a.rs = rs; a.rec = rec; a.nrec = nrec; a.box = box; a.seq = 0u; a.tick = tick; a.stats = stats;
    return xp_plan_impl(a, stream);
}

/* The plan's jobs copied from the pinned pool into the ring: kGatherWg work-groups a job, each a contiguous
 * share of 16-byte words; no grid barrier -- the last work-group to arrive writes `seq` to `done`, after a
 * device-scope release, and puts the counter back to zero. A group past the job count only arrives. */
extern "C" __attribute__((visibility("default")))
int rad_xp_gather_launch(const rad::XpBox* box, uint64_t max_bytes, uint32_t* done, uint32_t* ctr, uint32_t seq,
                         void* stream) {
    if (!box || !done || !ctr || max_bytes == 0) return -1;
    flush_pending();
    sycl::queue& q = *static_cast<sycl::queue*>(stream);
    constexpr uint32_t kGatherWg = 48, kWg = 256;
    constexpr uint32_t total = kGatherWg * (uint32_t)rad::kXpSlots;
    try {
        q.parallel_for(sycl::nd_range<1>((size_t)total * kWg, kWg), [=](sycl::nd_item<1> it) {
            const uint32_t g = (uint32_t)it.get_group(0), tid = (uint32_t)it.get_local_id(0);
            const uint32_t j = g / kGatherWg, part = g % kGatherWg;
            if ((int)j < box->n) {
                const u64 bytes = box->jobs[j].bytes < max_bytes ? box->jobs[j].bytes : max_bytes;
                const sycl::uint4* src = (const sycl::uint4*)(uintptr_t)box->jobs[j].src;
                sycl::uint4* dst = (sycl::uint4*)(uintptr_t)box->jobs[j].dst;
                const u64 words = bytes / 16u, share = (words + kGatherWg - 1) / kGatherWg;
                const u64 w0 = (u64)part * share, w1 = w0 + share < words ? w0 + share : words;
                for (u64 i = w0 + tid; i < w1; i += kWg) dst[i] = src[i];
                if (part == kGatherWg - 1 && tid < (uint32_t)(bytes % 16u))
                    ((unsigned char*)dst)[words * 16u + tid] = ((const unsigned char*)src)[words * 16u + tid];
            }
            sycl::group_barrier(it.get_group());
            if (tid == 0) {
                sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::device);
                const uint32_t was = sycl::atomic_ref<uint32_t, sycl::memory_order::acq_rel, sycl::memory_scope::device,
                                                      sycl::access::address_space::global_space>(*ctr).fetch_add(1u);
                if (was == total - 1) {
                    dev_atomic<uint32_t>(*ctr).store(0u);
                    dev_atomic<uint32_t>(*done).store(seq, sycl::memory_order::release);
                }
            }
        });
    } catch (const sycl::exception&) {
        return -1;
    }
    return 0;
}

/* Compute stream, before a layer's routed GEMMs: put back the previous layer's patches, then point this
 * layer's units at the ring where an entry still holds what the plan read and the gather has landed. */
namespace {
struct XpStepArgs { const rad::XpRec* rrec; const int32_t* rn; const rad::XpRec* prec; const int32_t* pn;
                    const uint32_t* done; uint32_t seq, pad; };   /* no padding bytes (see LogitsArgs) */
}  // namespace
/* v2 (owner note 139 stage 1): recorded once a layer, so its arguments are fixed. It puts back every other
 * group's patches (threads 0-23; at most kXpSlots x kXpParts entries a group, each a compare-and-swap that does
 * nothing where the entry no longer holds the patch), so no patch outlives the next routed layer, across passes
 * too; then, with `patch`, points this layer's units (group `g`) at the ring (threads 64-71) where `done` -- pinned
 * host memory the copy engine writes after the copies -- holds the group's current device ticket. The own group is
 * left out of the put-back: its records are this layer's plan, and the two would race on the same entries. */
namespace {
struct XpStep2Args { const rad::XpRec* rec; const int32_t* nrec; int32_t g, patch; const uint32_t* done;
                     const uint32_t* tick; };
}  // namespace
extern "C" __attribute__((visibility("default")))
int rad_xp_step2_launch(const rad::XpRec* rec, const int32_t* nrec, int g, int patch, const uint32_t* done,
                        const uint32_t* tick, void* stream) {
    if (!rec || !nrec || g < 0 || g >= rad::kXpGroups) return -1;
    flush_pending();
    const XpStep2Args a{ rec, nrec, g, patch, done, tick };
    auto kfn = [=](sycl::nd_item<1> it) {
        constexpr int kPer = rad::kXpSlots * rad::kXpParts;
        const int t = (int)it.get_local_id(0);
        if (t < rad::kXpGroups * kPer) {
            const int gg = t / kPer, j = (t % kPer) / rad::kXpParts, qq = t % rad::kXpParts;
            if (gg != a.g && j < a.nrec[gg]) {
                const rad::XpRec& r = a.rec[gg * rad::kXpSlots + j];
                if (r.ent[qq]) {
                    u64 want = (u64)r.newv[qq];
                    dev_atomic<u64>(*(u64*)r.ent[qq]).compare_exchange_strong(want, (u64)r.oldv[qq]);
                }
            }
            return;
        }
        if (!a.patch || !a.done || !a.tick || t < 64 || t >= 64 + kPer) return;
        const uint32_t want_seq = dev_atomic<uint32_t>(*(uint32_t*)a.tick).load();
        if (want_seq == 0 || sys_atomic<uint32_t>(*(uint32_t*)a.done).load(sycl::memory_order::acquire) != want_seq)
            return;
        const int j = (t - 64) / rad::kXpParts, qq = (t - 64) % rad::kXpParts;
        if (j >= a.nrec[a.g]) return;
        const rad::XpRec& r = a.rec[a.g * rad::kXpSlots + j];
        if (r.ent[qq]) {
            u64 want = (u64)r.oldv[qq];
            dev_atomic<u64>(*(u64*)r.ent[qq]).compare_exchange_strong(want, (u64)r.newv[qq]);
        }
    };
    return launch_1d(stream, a, kfn, 128, 128);
}

extern "C" __attribute__((visibility("default")))
int rad_xp_step_launch(const rad::XpRec* rrec, const int32_t* rn, const rad::XpRec* prec, const int32_t* pn,
                       const uint32_t* done, uint32_t seq, void* stream) {
    flush_pending();
    const XpStepArgs a{ rrec, rn, prec, pn, done, seq, 0u };
    auto kfn = [=](sycl::nd_item<1> it) {
        const int t = (int)it.get_local_id(0);
        if (a.rrec && t < *a.rn * rad::kXpParts) {
            const rad::XpRec& r = a.rrec[t / rad::kXpParts];
            const int qq = t % rad::kXpParts;
            if (r.ent[qq]) {
                u64 want = (u64)r.newv[qq];
                dev_atomic<u64>(*(u64*)r.ent[qq]).compare_exchange_strong(want, (u64)r.oldv[qq]);
            }
        }
        if (!a.prec) return;
        if (dev_atomic<uint32_t>(*(uint32_t*)a.done).load(sycl::memory_order::acquire) != a.seq)
            return;
        if (t >= *a.pn * rad::kXpParts) return;
        const rad::XpRec& r = a.prec[t / rad::kXpParts];
        const int qq = t % rad::kXpParts;
        if (r.ent[qq]) {
            u64 want = (u64)r.oldv[qq];
            dev_atomic<u64>(*(u64*)r.ent[qq]).compare_exchange_strong(want, (u64)r.newv[qq]);
        }
    };
    return launch_1d(stream, a, kfn, 128, 128);
}

extern "C" __attribute__((visibility("default")))
int rad_wtab_patch_launch(const rad::WtabPatch* p, void* stream) {
    if (!p || p->n == 0) return 0;
    flush_pending();
    const rad::WtabPatch w = *p;
    auto kfn = [=](sycl::nd_item<1> it) {
        const uint32_t i = (uint32_t)it.get_local_id(0);
        if (i < w.n) *w.dst[i] = w.val[i];
    };
    return launch_1d(stream, w, kfn, 64, 64);
}
